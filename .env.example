# 🔧 Core
DATABASE_URL=sqlite:///./data/business_flow.db   # или postgresql://bf:pass@postgres:5432/business_flow
JWT_SECRET=change-me-super-secret

# 👤 Seed-пользователи (создаются при первом запуске)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
MANAGER_LOGIN=manager
MANAGER_PASSWORD=manager123
BOT_LOGIN=telegram_bot
BOT_PASSWORD=bot_secret_change_me
SEED_DEMO=true

# 🤖 Telegram
TELEGRAM_BOT_TOKEN=
NOTIFY_CHAT_ID=

# ✉️ Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# 📊 Google Sheets (остатки): CSV-ключ сервисного аккаунта Google
GOOGLE_CREDENTIALS_FILE=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Stock

# ⏰ Расписание
DAILY_REPORT_HOUR=9
STOCK_CHECK_HOURS=3
LOW_STOCK_THRESHOLD=5

# 🔗 URL API для бота (в docker-compose: http://backend:8000)
API_PUBLIC_URL=http://backend:8000
